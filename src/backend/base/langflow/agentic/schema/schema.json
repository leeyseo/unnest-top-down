{
    "nudges": [
      {
        "id": "welcomeNudge",
        "display_text": "Welcome to Unnest Assistant!",
        "description": "Let’s help you start building your first Unnest workflow.",
        "type": "route",
        "trigger": {
          "action": "navigate",
          "payload": { "path": "/onboarding" }
        },
        "ui": {
          "icon": "sparkles",
          "variant_type": "pill",
          "variant_size": "small"
        }
      },
      {
        "id": "createFlow",
        "display_text": "Create a New Flow",
        "description": "Start a new Unnest project to design your agent pipeline.",
        "type": "route",
        "trigger": {
          "action": "navigate",
          "payload": { "path": "/flows/new" }
        },
        "ui": {
          "icon": "plus-circle",
          "variant_type": "pill",
          "variant_size": "small"
        }
      },
      {
        "id": "openComponent",
        "display_text": "Browse Components",
        "description": "Explore and add new components to your Unnest workspace.",
        "type": "route",
        "trigger": {
          "action": "navigate",
          "payload": { "path": "/components" }
        },
        "ui": {
          "icon": "puzzle",
          "variant_type": "pill",
          "variant_size": "small"
        }
      },
      {
        "id": "openLanguageModelComponent",
        "display_text": "Open LanguageModelComponent",
